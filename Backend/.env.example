PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=penetrative_library
DB_CONNECTION_LIMIT=10

# Leave empty to generate a temporary development secret, or set a random value
# of at least 32 characters. Always set this in production.
AUTH_TOKEN_SECRET=
TOKEN_TTL_SECONDS=604800

# Estimated fine charged per overdue day.
FINE_PER_DAY=10

# TinyFish powers the AI chat, book discovery, and recommendation routes.
TINYFISH_API_KEY=
# Python executable that has the TinyFish SDK installed.
TINYFISH_PYTHON=python

# Used only by `node seed-admin.js`.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
